// Grover OS — Kodiak boot screen
// 1. Black screen. The bear's blue eye ignites and builds.
// 2. The bear rises out of the dark around the eye.
// 3. GROVER KODIAK fades in. The eye keeps pulsing until the desktop loads.
// Timing runs on the real clock, so it plays the same at 60 Hz or 240 Hz.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

fun clamp01(v) { if (v < 0) return 0; if (v > 1) return 1; return v; }
fun ease(v) { v = clamp01(v); return 1 - (1 - v) * (1 - v); }
fun smooth(v) { v = clamp01(v); return v * v * (3 - 2 * v); }

// ---------- timeline (seconds) ----------
EYE_START   = 0.0;   EYE_LEN   = 1.6;   // eye ignites
BEAR_START  = 1.2;   BEAR_LEN  = 2.2;   // bear rises in around it
TITLE_START = 3.0;   TITLE_LEN = 1.0;   // title fades in
PULSE_START = 3.2;                      // eye settles into a slow pulse

// ---------- bear ----------
bear_src = Image("bear.png");
bw = sw * 0.55;
bh = bw * bear_src.GetHeight() / bear_src.GetWidth();
if (bh > sh * 0.55) { bh = sh * 0.55; bw = bh * bear_src.GetWidth() / bear_src.GetHeight(); }
s = bw / bear_src.GetWidth();
bear = Sprite(bear_src.Scale(bw, bh));
bx = (sw - bw) / 2;
by = sh * 0.40 - bh / 2;
RISE = sh * 0.04;
bear.SetX(bx);
bear.SetY(by + RISE);
bear.SetZ(10);
bear.SetOpacity(0);

// ---------- eye ----------
EYE_X = 380;
EYE_Y = 280;
glow_src = Image("glow.png");
gmax = 200 * s * 2.0;
glow = Sprite(glow_src.Scale(gmax, gmax));
glow.SetZ(20);
glow.SetOpacity(0);
fun place_eye(size, yoff)
{
    glow.SetImage(glow_src.Scale(size, size));
    glow.SetX(bx + EYE_X * s - size / 2);
    glow.SetY(by + yoff + EYE_Y * s - size / 2);
}
place_eye(gmax * 0.3, RISE);

// ---------- title ----------
title_src = Image("title.png");
tw = bw * 0.62;
th = tw * title_src.GetHeight() / title_src.GetWidth();
title = Sprite(title_src.Scale(tw, th));
title.SetX((sw - tw) / 2);
title.SetY(by + bh + sh * 0.02);
title.SetZ(10);
title.SetOpacity(0);

sub_src = Image("subtitle.png");
uw = tw * 0.45;
uh = uw * sub_src.GetHeight() / sub_src.GetWidth();
sub = Sprite(sub_src.Scale(uw, uh));
sub.SetX((sw - uw) / 2);
sub.SetY(by + bh + sh * 0.02 + th);
sub.SetZ(10);
sub.SetOpacity(0);

// ---------- clock ----------
// The screen redraws at the monitor's refresh rate (240 a second on the Kodiak,
// 60 on most screens), so counting redraws alone runs too fast on fast monitors.
// Plymouth reports real elapsed time through the boot-progress callback.
// Each report measures how many redraws happened per real second, and
// between reports we count redraws at that measured rate.
start_time = -1;
base_time = 0;
last_dur = -1;
ticks = 0;
rate = 240;           // first guess, corrected after the first report
shown = 0;            // time never runs backwards on screen
fun progress_callback(duration, progress)
{
    if (start_time < 0) start_time = duration;
    if (last_dur >= 0 && duration > last_dur && ticks > 0)
    {
        r = ticks / (duration - last_dur);
        if (r >= 20 && r <= 400) rate = r;
    }
    last_dur = duration;
    base_time = duration - start_time;
    ticks = 0;
}
Plymouth.SetBootProgressFunction(progress_callback);

last_size = -1;
fun refresh_callback()
{
    ticks++;
    now = base_time + ticks / rate;
    if (now < shown) now = shown;
    shown = now;

    // 1. eye ignites: grows from a spark to full glow
    e = smooth((now - EYE_START) / EYE_LEN);
    // 2. bear rises in
    b = ease((now - BEAR_START) / BEAR_LEN);
    yoff = RISE * (1 - b);
    bear.SetOpacity(b);
    bear.SetY(by + yoff);

    // 3. after the build, the eye breathes
    p = 1;
    if (now > PULSE_START)
        p = 0.6 + 0.4 * (Math.Sin((now - PULSE_START) * 2.4 + 1.5708) + 1) / 2;

    size = gmax * (0.3 + 0.7 * e);
    if (size != last_size || b < 1) { place_eye(size, yoff); last_size = size; }
    glow.SetOpacity(e * p);

    // 4. title
    ta = smooth((now - TITLE_START) / TITLE_LEN);
    title.SetOpacity(ta);
    sub.SetOpacity(ta * 0.9);
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---------- password prompt (only if the disk is encrypted) ----------
prompt = NULL;
bullets = NULL;
fun display_password_callback(text, count)
{
    prompt = Sprite(Image.Text(text, 1, 1, 1));
    prompt.SetX((sw - prompt.GetImage().GetWidth()) / 2);
    prompt.SetY(sh * 0.86);
    prompt.SetZ(30);
    stars = "";
    for (i = 0; i < count; i++) stars += "* ";
    bullets = Sprite(Image.Text(stars, 0.23, 0.61, 1));
    bullets.SetX((sw - bullets.GetImage().GetWidth()) / 2);
    bullets.SetY(sh * 0.86 + 30);
    bullets.SetZ(30);
}
fun display_normal_callback() { prompt = NULL; bullets = NULL; }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---------- messages ----------
msg = NULL;
fun message_callback(text)
{
    msg = Sprite(Image.Text(text, 0.6, 0.6, 0.6));
    msg.SetX((sw - msg.GetImage().GetWidth()) / 2);
    msg.SetY(sh * 0.94);
    msg.SetZ(30);
}
Plymouth.SetMessageFunction(message_callback);
